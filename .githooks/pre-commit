#!/bin/sh
# Runs the same checks as CI before every commit: gofmt, go vet, tests with
# the race detector, and golangci-lint. Enable with `make hooks`.
set -eu

cd "$(git rev-parse --show-toplevel)"

staged=$(git diff --cached --name-only --diff-filter=ACM -- '*.go')
[ -n "$staged" ] || exit 0

unformatted=$(echo "$staged" | xargs gofmt -l)
if [ -n "$unformatted" ]; then
	echo "pre-commit: these files are not gofmt-formatted:" >&2
	echo "$unformatted" >&2
	echo "run 'make fmt' (or gofmt -w) and stage them again" >&2
	exit 1
fi

if ! command -v golangci-lint >/dev/null 2>&1; then
	echo "pre-commit: golangci-lint not found in PATH" >&2
	echo "install: go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@latest" >&2
	exit 1
fi

make check
